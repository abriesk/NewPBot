# Copy to .env and fill in. .env is git-ignored and MUST stay that way.
# Everything the therapist can change at runtime -- availability, booking mode,
# prices, reminder offsets, retention -- is a database setting in the admin UI,
# not a variable here.

# --- Database ----------------------------------------------------------------
POSTGRES_DB=psychobooking
POSTGRES_USER=psycho
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://psycho:change-me@db:5432/psychobooking

# --- Core --------------------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-at-least-32-random-bytes-0000
# Public origin, no trailing slash.
BASE_URL=https://booking.example.com

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_BOT_USERNAME=your_bot
# Sent as X-Telegram-Bot-Api-Secret-Token. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me
# Leave blank to generate an unguessable path at startup.
TELEGRAM_WEBHOOK_PATH=
# webhook | polling (polling is for development only)
TELEGRAM_MODE=webhook
# Comma-separated Telegram user IDs allowed into the bot's admin surface.
TELEGRAM_ADMIN_IDS=

# --- Email (outbound only) ---------------------------------------------------
# Leave SMTP_HOST unset to disable the email channel cleanly: no email
# identities, no email outbox rows, Telegram login only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SHOULD match the authenticated account's domain, for SPF/DMARC.
SMTP_FROM=
SMTP_STARTTLS=true

# --- Seed values (read once, at first startup) -------------------------------
PRACTICE_NAME=Practice
# IANA name. Never a UTC offset -- offsets break at DST.
PRACTICE_TIMEZONE=Asia/Yerevan
# ru | hy | en
DEFAULT_LANGUAGE=ru
ADMIN_USERNAME=admin
# Hashed at first startup; the plaintext is never stored or logged.
ADMIN_PASSWORD=change-me

# --- Runtime -----------------------------------------------------------------
WORKER_POLL_SECONDS=20
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

# --- Deployment --------------------------------------------------------------
# tls (default) | plain | plain,cloudflared
COMPOSE_PROFILES=tls

# Required by the tls profile, where Caddy needs a hostname to get a
# certificate for. Leave both blank under plain or cloudflared -- a tunnel
# gives you a hostname without you owning a domain, and nothing here needs one.
# The tls profile refuses to start with either of them empty.
DOMAIN=
ACME_EMAIL=

# Required by the cloudflared profile only.
TUNNEL_TOKEN=

# --- Backups (§16.6) ---------------------------------------------------------
# The `backup` service dumps the database here once a day. The path is on the
# host, so the dumps survive `docker compose down` and can be copied off with
# scp. It is created 0700: the dumps contain clients' problem text, and
# encrypting them and copying them off-host is still your job.
BACKUP_DIR=./backups
# 0-23, UTC.
BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=30
